{
  "name": "anoglobe-web",
  "private": true,
  "scripts": {
    "dev": "next dev -p 7290",
    "build": "next build",
    "start": "next start -p 7290",
    "db:up": "docker compose --env-file .env.local up -d",
    "test": "node --test lib/*.test.mjs",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "admin:create": "node --env-file=.env.local scripts/create-admin.mjs",
    "demo:seed": "node --env-file=.env.local scripts/demo-data.mjs",
    "demo:clear": "node --env-file=.env.local scripts/demo-data.mjs --clear"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "next": "^16.4.5",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "browserslist": [
    "chrome >= 123",
    "edge >= 123",
    "firefox >= 120",
    "safari >= 17.5"
  ]
}
